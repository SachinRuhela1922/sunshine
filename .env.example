# Copy this file to .env (local) or set these in Render > Environment.
# Never commit the real .env file.

# MongoDB Atlas connection string (ROTATE the old password - it was public on GitHub)
MONGODB_URI=
# Long random string, 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_SECRET=

# Admin login password (no longer stored in index.html)
ADMIN_PASSWORD=

# Optional: frontend URL(s), comma separated. Empty = allow all origins.
ALLOWED_ORIGINS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
